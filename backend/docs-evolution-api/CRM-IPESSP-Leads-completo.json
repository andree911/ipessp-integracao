        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.IA_BEARER_TOKEN }}" }]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1040, 400],
      "id": "eb1c2d3e-1111-1111-1111-000000000005",
      "name": "Avançar Etapa Nurturing"
    },

    {
