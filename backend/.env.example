# ============================================================
# SophiA SGx API
# ============================================================

# URL base do servidor SophiA da sua instituição.
# Exemplo: https://sophia.minhaescola.com.br/SophiAWebAPI
# Onde achar: com o suporte da SophiA ou setor de TI da escola.
SOPHIA_BASE_URL=https://SEU-SERVIDOR/SophiAWebAPI

# Token de autenticação da API SophiA.
# Onde achar: chame POST {SOPHIA_BASE_URL}/api/v1/Autenticacao com o usuário
# e senha de integração configurados no painel da SophiA (menu Configurações > API).
# O token retornado é o valor deste campo.
SOPHIA_TOKEN=SEU-TOKEN-SOPHIA

# Tenant (opcional). Identificador numérico da unidade/empresa no SophiA.
# Onde achar: aparece na URL do sistema SophiA da sua escola (ex: /6150/).
# Deixe em branco se não usar multi-tenant.
SOPHIA_TENANT=

# ============================================================
# Receiv API
# ============================================================

# URL base da sua conta na Receiv.
# Onde achar: fornecida pela Receiv no onboarding. Formato: https://suaempresa.receiv.it/integracao
RECEIV_BASE_URL=https://suaempresa.receiv.it/integracao

# Chave secreta para assinar os JWTs enviados à Receiv.
# Onde achar: painel da Receiv > Configurações > Integração > "JWT Secret".
RECEIV_JWT_SECRET=SUA-CHAVE-SECRETA

# Issuer do JWT (identifica quem está gerando o token).
# Onde achar: painel da Receiv > Configurações > Integração > "ISS".
RECEIV_JWT_ISS=SUA-ISS

# IST do JWT (identificador do sistema integrado).
# Onde achar: painel da Receiv > Configurações > Integração > "IST".
RECEIV_JWT_IST=SUA-IST

# Código do credor (sua escola) dentro da Receiv.
# Onde achar: painel da Receiv > Configurações > Dados do Credor > "Código do Credor".
RECEIV_CODIGO_CREDOR=0

# ============================================================
# Banco de dados (SQLite local — controle de sincronização)
# ============================================================
DATABASE_PATH=./data/sync.db

# ============================================================
# Sincronização
# ============================================================
# Expressão cron: define quando o job roda automaticamente.
# Padrão: todo início de hora. Formato: minuto hora dia mês dia-semana
SYNC_CRON=0 * * * *

# Janela retroativa de lançamentos buscados no SophiA (dias).
# Na primeira execução recomenda-se 90 ou mais para pegar o histórico.
SYNC_LOOKBACK_DAYS=30

# ============================================================
# Servidor / Webhook
# ============================================================
PORT=3000

# Segredo enviado pela Receiv no header X-Webhook-Secret de cada webhook.
# Onde achar/configurar: painel da Receiv > Configurações > Webhooks > "Secret".
WEBHOOK_SECRET=mude-este-segredo

# ============================================================
# IA / OpenClaw — endpoints protegidos por Bearer Token
# ============================================================

# Token secreto que o OpenClaw enviará no header Authorization: Bearer <token>.
# Crie um valor aleatório forte (ex: openssl rand -hex 32) e configure o mesmo
# no painel do OpenClaw como "Authorization Header" da ferramenta.
IA_BEARER_TOKEN=mude-este-token-ia

# ============================================================
# Supabase — avisos, calendário e dados de CRM
# ============================================================

# URL do seu projeto Supabase.
# Onde achar: painel Supabase > Settings > API > "Project URL"
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Service Role Key do Supabase (acesso total, use só no servidor).
# Onde achar: painel Supabase > Settings > API > "service_role" key
SUPABASE_SERVICE_KEY=sua-service-role-key
