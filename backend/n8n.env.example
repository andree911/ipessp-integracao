# ============================================================
# Variáveis de ambiente do n8n — IPESSP
# ============================================================
# Configure no painel do n8n:
#   n8n Cloud   → Settings > Variables > Add Variable
#   Self-hosted → adicione no .env do servidor n8n antes de iniciar
#
# Estas variáveis são referenciadas nos fluxos em docs/ via $env.NOME
# ============================================================

# ============================================================
# Backend (ipessp-core — Render)
# ============================================================

# URL pública do backend sem barra no final.
# Onde achar: Render > seu serviço > Settings > URL
# Mesmo valor de SITE_URL ou a URL do Render diretamente.
CORE_API_URL=https://SEU-SERVICO.onrender.com

# Chave de acesso ao painel /v1/admin do backend (ADMIN_API_KEY).
# NÃO é mais usada por nenhum fluxo em docs/ (Bot-IPESSP-WhatsApp.json e
# CRM-IPESSP-Leads-completo.json foram migrados pra IA_BEARER_TOKEN). Só
# configure isso se você tiver algum fluxo próprio chamando /v1/admin/*.
CORE_API_KEY=mude-esta-chave-admin

# Token dos endpoints /ia/* e /v1/leads/* e /v1/ti/* (protegidos por IaBearerGuard).
# Deve ser o mesmo valor de IA_BEARER_TOKEN no .env do backend.
# Enviado como: Authorization: Bearer <valor>
IA_BEARER_TOKEN=mude-este-token-ia

# ============================================================
# Z-API — WhatsApp
# ============================================================
# Painel Z-API > sua instância > Credenciais

ZAPI_INSTANCE_ID=sua-instance-id
ZAPI_TOKEN=seu-token
ZAPI_CLIENT_TOKEN=seu-client-token

# Telefone que recebe alertas de novos leads e relatórios diário/semanal (CRM).
# Formato internacional sem +. Ex: 5511940343994
ZAPI_TELEFONE_EQUIPE=5511940343994
