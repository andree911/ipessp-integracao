{
  "name": "CRM IPESSP — Leads (Evolution API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ipessp-crm-leads-evolution",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "e86f518b-eede-41ac-8adc-d9af6c955df4",
      "name": "Webhook Novo Lead",
      "webhookId": "ipessp-crm-leads-evolution"
    },
    {
      "parameters": {
        "jsCode": "// Evolution API não exige template pré-aprovado — texto livre direto.\nconst lead = $input.first().json.body;\nconst data = new Date(lead.criadoEm).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nconst mensagem = `🎯 Novo Lead Captado!\\n\\nNome: ${lead.nome}\\nE-mail: ${lead.email || 'não informado'}\\nTelefone: ${lead.telefone || 'não informado'}\\nInteresse: ${lead.cursoInteresse || 'não informado'}\\nOrigem: ${lead.origem} — ${data}`;\n\nreturn [{ json: { mensagem } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [272, 0],
      "id": "e0fe9e60d-c7a2-48bf-b2e9-32c7529f943a",
      "name": "Formatar Mensagem Lead"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_MARKETING }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $env.WHATSAPP_TELEFONE_EQUIPE, textMessage: { text: $json.mensagem } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [528, 0],
      "id": "e43c69e3c-3263-4e6b-8ee0-04936306d0b0",
      "name": "Notificar Equipe WhatsApp"
    },

    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 400],
      "id": "eb1c2d3e-1111-1111-1111-000000000001",
      "name": "Nurturing a cada 30 min"
    },
    {
      "parameters": {
        "url": "={{ $env.CORE_API_URL }}/v1/leads/prontos-para-contato",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.IA_BEARER_TOKEN }}" }]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [272, 400],
      "id": "eb1c2d3e-1111-1111-1111-000000000002",
      "name": "Buscar Prontos para Contato"
    },
    {
      "parameters": {
        "jsCode": "// Mensagens de nutrição continuam exigindo opt-in explícito do lead pra WhatsApp\n// (campo `whatsappOptin`, vem direto do GET /v1/leads/prontos-para-contato) — essa\n// regra é nossa, independe do provedor. Sem opt-in o lead continua avançando de\n// etapa normalmente, só não recebe o WhatsApp (ver IF \"Tem Opt-in WhatsApp?\" abaixo).\n// Evolution API não exige template pré-aprovado — texto livre montado aqui direto,\n// mesmo conteúdo que seria submetido como template na versão Meta/360dialog.\nconst leads = $input.first().json;\nif (!Array.isArray(leads) || leads.length === 0) return [];\n\nconst textosPorEtapa = [\n  (nome, curso) => `Olá, ${nome}! 👋 Ficamos felizes com seu interesse no IPESSP, especialmente no curso de ${curso}! Sou a assistente virtual e estou aqui para tirar suas dúvidas. Pode me perguntar qualquer coisa! 📚`,\n  (nome, curso) => `${nome}, vi que você ainda está conhecendo o IPESSP! 🎓 Posso te ajudar com cursos disponíveis, formas de pagamento e próximas turmas de ${curso}. Responda aqui ou fale com nossa equipe!`,\n  (nome, curso) => `⏰ ${nome}, as vagas de ${curso} estão preenchendo! Processo seletivo simples, parcelamento facilitado e certificado reconhecido. Garanta sua vaga: https://ipessp.edu.br/inscricao`,\n];\n\nreturn leads\n  .filter(lead => lead.telefone)\n  .map(lead => {\n    const idx = Math.min(lead.etapaNurturing ?? 0, textosPorEtapa.length - 1);\n    const nome = lead.nome;\n    const curso = lead.cursoInteresse || 'nossos cursos';\n    return {\n      json: {\n        leadId: lead.id,\n        phone: (lead.telefone || '').replace(/\\D/g, ''),\n        enviarWhatsapp: !!lead.whatsappOptin,\n        mensagem: textosPorEtapa[idx](nome, curso),\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [528, 400],
      "id": "eb1c2d3e-1111-1111-1111-000000000003",
      "name": "Montar Mensagens Nurturing"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "eo1o1o1o1-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.enviarWhatsapp }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [656, 400],
      "id": "eo1o1o1o1-0002-4000-8000-000000000002",
      "name": "Tem Opt-in WhatsApp?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_MARKETING }}",
