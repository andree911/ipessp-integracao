# ─── Backend (integracao-sophia-n8n) — usado pelas rotas de API server-side ──
# (app/api/lead, app/api/matriculas, app/api/portal/auth/*)
API_URL=https://integracao-sophia-n8n.onrender.com
LEADS_API_KEY=
MATRICULAS_API_KEY=

# ─── Backend — usado direto do browser (app/lib/api.ts) ──────────────────────
NEXT_PUBLIC_API_URL=https://integracao-sophia-n8n.onrender.com

# Link do edital/pré-inscrição no botão de Processo Seletivo — se vazio, cai
# no fallback "#pre-inscricao" (âncora na própria página)
NEXT_PUBLIC_EDITAL_URL=

# URL do portal do aluno (Sophia) usada em app/lib/contato.ts
NEXT_PUBLIC_SOPHIA_PORTAL_URL=https://portal.ipessp.edu.br
