    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst hoje = new Date().toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nconst funilLines = (r.funil || []).map(f => `• ${f.estagio}: ${f.total}`).join('\\n') || '• sem dados';\nconst origemLines = (r.porOrigem || []).map(o => `• ${o.origem}: ${o.total}`).join('\\n') || '• sem dados';\n\nreturn [{ json: {\n  mensagem:\n    `📊 *Relatório Semanal de Leads — IPESSP*\\n` +\n    `📅 ${hoje}\\n\\n` +\n    `📈 Total geral: ${r.total}\\n` +\n    `🗓️ Novos este mês: ${r.noMes}\\n` +\n    `📡 Em nurturing ativo: ${r.emNurturing}\\n` +\n    `📊 Taxa de conversão: ${r.taxaConversao}\\n\\n` +\n    `🔽 *Funil:*\\n${funilLines}\\n\\n` +\n    `🌐 *Por Origem:*\\n${origemLines}`\n}}];"
      },
