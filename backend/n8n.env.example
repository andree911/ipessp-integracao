# ============================================================
# Variáveis de ambiente do n8n — IPESSP
# ============================================================
# Configure no painel do n8n:
#   n8n Cloud   → Settings > Variables > Add Variable
#   Self-hosted → adicione no .env do servidor n8n antes de iniciar
#
# Estas variáveis são referenciadas nos fluxos em docs/ via $env.NOME
# ============================================================

# ============================================================
# Backend integracao-sophia-n8n (este projeto)
# ============================================================

# Endereço deste backend (integracao-service) visto pelo n8n, sem barra no
# final. Usado hoje pelas tools "Abrir Chamado TI", "Consultar Chamados TI"
# e "Consultar Cursos" do Bot-IPESSP-WhatsApp.json.
# Como n8n e integracao-service rodam no mesmo Docker Compose na VPS, o valor
# em produção é o nome do serviço na rede interna (ex: http://integracao-service:3000),
# não mais uma URL do Render.
CORE_API_URL=http://integracao-service:3000

# Chave de acesso ao painel /v1/admin do backend (ADMIN_API_KEY), enviada
# como header x-admin-key. Continua em uso: além das tools acima (contra
# CORE_API_URL), as tools "Verificar Lead CRM", "Registrar Lead CRM" e
# "Registrar Interação Bot" do mesmo fluxo também enviam esse header, mas
# contra o backend ipessp-core (ver IPESSP_CORE_URL abaixo) — os dois
# backends precisam aceitar o mesmo valor de chave.
CORE_API_KEY=mude-esta-chave-admin

# Token dos endpoints /ia/* e /v1/leads/* e /v1/ti/* (protegidos por IaBearerGuard).
# Deve ser o mesmo valor de IA_BEARER_TOKEN no .env do backend.
# Enviado como: Authorization: Bearer <valor>
IA_BEARER_TOKEN=mude-este-token-ia

# ============================================================
# Backend ipessp-core (projeto/repositório separado, Render)
# ============================================================

# URL pública do backend ipessp-core — um repositório diferente deste,
# hospedado no Render — sem barra no final. Usado pelas tools de CRM/leads
# do bot ("Verificar Lead CRM", "Registrar Lead CRM", "Registrar Interação
# Bot" em Bot-IPESSP-WhatsApp.json), que chamam /crm/leads, /crm/leads/verificar
# e /crm/leads/registrar-interacao-bot, protegidos por x-admin-key (CORE_API_KEY).
IPESSP_CORE_URL=https://ipessp-core.onrender.com

# ============================================================
# Backend integracao-sophia-n8n — URL pública (via Caddy)
# ============================================================

# URL pública HTTPS deste mesmo backend (integracao-service), sem barra no
# final, exposta pelo Caddy na VPS. Usada pelas tools de IA do bot que
# chamam /ia/* diretamente pela internet: financeiro, cpf-por-telefone,
# associar-telefone, secretaria, secretaria/professor,
# secretaria/professor/alunos e boleto/enviar.
INTEGRACAO_API_URL=https://srv1835634.hstgr.cloud

# ============================================================
# Z-API — WhatsApp
# ============================================================
# Painel Z-API > sua instância > Credenciais

ZAPI_INSTANCE_ID=sua-instance-id
ZAPI_TOKEN=seu-token
ZAPI_CLIENT_TOKEN=seu-client-token

# Telefone que recebia alertas de novos leads e relatórios diário/semanal do
# CRM. Não é mais referenciada por nenhum fluxo em docs/ (esse fluxo de CRM
# roda hoje no repositório ipessp-core) — mantida aqui só caso um fluxo
# próprio precise dela.
# Formato internacional sem +. Ex: 5511940343994
ZAPI_TELEFONE_EQUIPE=5511940343994
