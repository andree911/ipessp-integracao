# ============================================================
# Variáveis de ambiente do n8n — IPESSP
# ============================================================
# Configure no painel do n8n:
#   n8n Cloud   → Settings > Variables > Add Variable
#   Self-hosted → adicione no .env do servidor n8n antes de iniciar
#
# Estas variáveis são referenciadas nos fluxos em docs/ via $env.NOME
# ============================================================

# ============================================================
# Backend integracao-sophia-n8n (este projeto)
# ============================================================

# Endereço deste backend (integracao-service) visto pelo n8n, sem barra no
# final. Usado pelas tools /ia/* que envolvem SophiA: Consultar Financeiro,
# Salvar CPF do Telefone, cpf-por-telefone, Consultar Secretaria, Consultar
# Professor, Listar Alunos da Disciplina, Consultar Cursos, Enviar Boleto PDF,
# avisos e calendario, em Bot-IPESSP-WhatsApp.json.
# Como n8n e integracao-service rodam no mesmo Docker Compose na VPS, o valor
# em produção é o nome do serviço na rede interna (http://integracao-service:3000).
# Renomeada de CORE_API_URL em 2026-08-05 -- o nome antigo confundia com
# IPESSP_CORE_URL, apesar de apontar pro serviço errado (backend deste
# projeto, não o ipessp-core).
INTEGRACAO_API_URL=http://integracao-service:3000

# Token dos endpoints /ia/* deste backend (protegidos por IaBearerGuard).
# Deve ser o mesmo valor de IA_BEARER_TOKEN no .env do backend.
# Enviado como: Authorization: Bearer <valor>
IA_BEARER_TOKEN=mude-este-token-ia

# ============================================================
# Backend ipessp-core (projeto/repositório separado, VPS)
# ============================================================

# URL do backend ipessp-core — repositório diferente deste, hoje na mesma
# VPS Docker Compose (o domínio Render antigo, ipessp-core.onrender.com,
# está suspenso, não usar). Em produção o valor é o nome do serviço na rede
# interna (http://ipessp-core:3000). Usado pelas tools /ti/*, /crm/* e
# curso-pdf/enviar do bot ("Abrir Chamado TI", "Consultar Chamados TI",
# "Registrar Lead CRM", "Verificar Lead CRM", "Registrar Interação Bot",
# "Enviar Informativo do Curso"), protegidas por x-admin-key.
IPESSP_CORE_URL=http://ipessp-core:3000

# = ADMIN_API_KEY do ipessp-core, enviada como header x-admin-key nas
# chamadas contra IPESSP_CORE_URL acima.
CORE_API_KEY=mude-esta-chave-admin

# ============================================================
# Z-API — WhatsApp
# ============================================================
# Painel Z-API > sua instância > Credenciais

ZAPI_INSTANCE_ID=sua-instance-id
ZAPI_TOKEN=seu-token
ZAPI_CLIENT_TOKEN=seu-client-token

# Telefone que recebia alertas de novos leads e relatórios diário/semanal do
# CRM. Não é mais referenciada por nenhum fluxo em docs/ (esse fluxo de CRM
# roda hoje no repositório ipessp-core) — mantida aqui só caso um fluxo
# próprio precise dela.
# Formato internacional sem +. Ex: 5511940343994
ZAPI_TELEFONE_EQUIPE=5511940343994

# ============================================================
# Modo de teste — Bot IPESSP WhatsApp Core
# ============================================================
# Node "Filtro Modo Teste" (logo após o Webhook): quando ZAPI_MODO_TESTE=true,
# o fluxo passa a ignorar toda mensagem que não vier de ZAPI_TELEFONE_TESTE —
# útil pra testar o fluxo de verdade (n8n real, não a suíte de testes) sem
# responder clientes reais. Deixe ZAPI_MODO_TESTE=false (ou a variável ausente)
# em produção; ligar e esquecer de desligar bloqueia todo mundo, exceto o
# número de teste.
ZAPI_MODO_TESTE=false
ZAPI_TELEFONE_TESTE=5511940343994
