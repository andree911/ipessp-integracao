            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.phone, textMessage: { text: $json.mensagem } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [784, 320],
      "id": "eb1c2d3e-1111-1111-1111-000000000004",
      "name": "Enviar WhatsApp Nurturing",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.CORE_API_URL + '/v1/leads/' + $('Montar Mensagens Nurturing').item.json.leadId + '/nurturing-avanco' }}",
