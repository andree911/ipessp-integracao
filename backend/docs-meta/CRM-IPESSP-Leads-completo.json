    {
      "parameters": {
        "jsCode": "// Template \"relatorio_semanal_leads\" (4 variáveis) — ver docs-meta/README.md.\n// O detalhamento por funil/origem não cabe bem em variável de template (texto livre\n// e tamanho variável); ficou de fora da mensagem — quem quiser o detalhe abre o dashboard.\nconst r = $input.first().json;\n\nreturn [{ json: {\n  total: String(r.total),\n  noMes: String(r.noMes),\n  emNurturing: String(r.emNurturing),\n  taxaConversao: String(r.taxaConversao),\n}}];"
