# ============================================================
# Legado: template de quando o n8n rodava no Render
# (n8n-ipessp.onrender.com). Hoje o n8n roda via Docker Compose na VPS
# (docker-compose.yml + n8n-vars.env em /opt/ipessp/ no servidor) e as vars
# de DB_POSTGRESDB_*/N8N_HOST/PORT/WEBHOOK_URL abaixo não refletem o setup
# atual (lá quem define isso é o próprio docker-compose.yml, com
# N8N_EDITOR_BASE_URL/N8N_WEBHOOK_URL apontando pra srv1835634.hstgr.cloud).
# Para as variáveis realmente referenciadas pelos fluxos ($env.NOME em
# docs/*.json) hoje, ver n8n.env.example.
# ============================================================
INTEGRACAO_API_URL=
DB_POSTGRESDB_DATABASE=
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_USER=
DB_TYPE=postgresdb
IA_BEARER_TOKEN=
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENCRYPTION_KEY=
N8N_HOST=n8n-ipessp.onrender.com
N8N_PORT=5678
N8N_PROTOCOL=https
NODE_OPTIONS="--max-old-space-size=400"
PORT=5678
WEBHOOK_URL=https://n8n-ipessp.onrender.com
ZAPI_CLIENT_TOKEN=
ZAPI_INSTANCE_ID=
ZAPI_TELEFONE_EQUIPE=
ZAPI_TOKEN=
