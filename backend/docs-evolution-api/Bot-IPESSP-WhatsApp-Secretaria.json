    {
      "parameters": {
        "jsCode": "const cpfData = $input.first().json;\nconst webhook = $('Webhook').first().json;\nconst msg = webhook.body.text.message;\n\nlet enriched = msg;\n\nif (cpfData.cpf && !cpfData.error && !cpfData.message) {\n  enriched = `[Sistema: CPF: ${cpfData.cpf}${cpfData.nomeResponsavel ? `, responsável: ${cpfData.nomeResponsavel}` : ''}${cpfData.tipo ? `, tipo: ${cpfData.tipo}` : ''}${cpfData.email ? `, email: ${cpfData.email}` : ''}. Use-o diretamente sem pedir ao usuário.]\\n\\n${msg}`;\n}\n\nreturn [{ json: { ...webhook, body: { ...webhook.body, text: { message: enriched } } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [848, -96],
      "id": "esca32d0c-3f5e-45be-96fb-227928b4e666",
