    {
      "parameters": {
        "jsCode": "// ATENÇÃO: formato baseado no padrão documentado/conhecido da Evolution API\n// (evento messages.upsert, estrutura Baileys). Confirme com um payload real da\n// sua instância antes de ir pra produção — ver docs-evolution-api/README.md.\nconst body = $input.first().json.body;\nconst data = body.data;\nconst key = data.key;\n\nconst phone = (key.remoteJid || '').split('@')[0];\nconst fromMe = !!key.fromMe;\nconst msg = data.message || {};\n\nlet text;\nlet listResponseMessage;\n\nif (msg.conversation) {\n  text = { message: msg.conversation };\n} else if (msg.extendedTextMessage?.text) {\n  text = { message: msg.extendedTextMessage.text };\n} else if (msg.listResponseMessage) {\n  listResponseMessage = {\n    rowId: msg.listResponseMessage.singleSelectReply?.selectedRowId,\n    title: msg.listResponseMessage.title,\n  };\n} else if (msg.buttonsResponseMessage) {\n  listResponseMessage = {\n    rowId: msg.buttonsResponseMessage.selectedButtonId,\n    title: msg.buttonsResponseMessage.selectedDisplayText,\n  };\n}\n// outros tipos (imageMessage, audioMessage, documentMessage, stickerMessage etc.)\n// ficam sem `text` e caem no fluxo de \"mídia não suportada\"\n\nreturn [{ json: { body: { phone, fromMe, text, listResponseMessage } } }];"
      },
