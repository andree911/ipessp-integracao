    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst phone = item.body.phone;\n\n// Sem isso, cada mensagem numa conversa corrida (ex: \"oi\", \"quero saber de enfermagem\",\n// \"quanto custa\") virava um POST /crm/leads + confirmação repetida pro lead + aviso novo\n// pra consultora -- a cada mensagem. Cooldown de 30min por telefone: dentro da janela,\n// não encaminha de novo; passado esse tempo, uma nova mensagem volta a encaminhar\n// normalmente (reengajamento depois de um tempo continua avisando).\nconst COOLDOWN_MS = 30 * 60 * 1000;\nconst staticData = $getWorkflowStaticData('global');\nstaticData.ultimoContato = staticData.ultimoContato || {};\n\nconst agora = Date.now();\nconst ultimo = staticData.ultimoContato[phone];\n\nif (ultimo && (agora - ultimo) < COOLDOWN_MS) {\n  return [];\n}\n\nstaticData.ultimoContato[phone] = agora;\nreturn [{ json: item }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "d4249b65-ff13-42a1-94d0-6197e83409d7",
      "name": "Cooldown de Encaminhamento"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.IPESSP_CORE_URL }}/crm/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-admin-key",
              "value": "={{ $env.CORE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ nome: $('If - Tem Texto').item.json.body.senderName, telefone: $('If - Tem Texto').item.json.body.phone, observacao: $('If - Tem Texto').item.json.body.text?.message ?? $('If - Tem Texto').item.json.body.listResponseMessage?.title ?? '', whatsappOptin: false, origem: 'chatbot' }) }}",
        "options": {}
      },
