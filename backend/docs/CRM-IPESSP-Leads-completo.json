      "name": "Webhook Novo Lead",
      "webhookId": "ipessp-crm-leads"
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json.body;\nconst data = new Date(lead.criadoEm).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nreturn [{ json: {\n  mensagem:\n    `🎯 *Novo Lead Captado!*\\n\\n` +\n    `👤 Nome: ${lead.nome}\\n` +\n    `📧 E-mail: ${lead.email || 'não informado'}\\n` +\n    `📱 Telefone: ${lead.telefone || 'não informado'}\\n` +\n    `📚 Interesse: ${lead.cursoInteresse || 'não informado'}\\n` +\n    `🌐 Origem: ${lead.origem}\\n` +\n    `⏰ Em: ${data}`\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [272, 0],
      "id": "0fe9e60d-c7a2-48bf-b2e9-32c7529f943a",
      "name": "Formatar Mensagem Lead"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.z-api.io/instances/' + $env.ZAPI_INSTANCE_ID + '/token/' + $env.ZAPI_TOKEN + '/send-text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Client-Token", "value": "={{ $env.ZAPI_CLIENT_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $env.ZAPI_TELEFONE_EQUIPE }}\",\n  \"message\": \"{{ $json.mensagem }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [528, 0],
      "id": "43c69e3c-3263-4e6b-8ee0-04936306d0b0",
      "name": "Notificar Equipe WhatsApp"
    },

    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
