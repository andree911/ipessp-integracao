# --- WhatsApp: API oficial da Meta (Cloud API) via 360dialog (provedor decidido) ---
# URL completa de envio de mensagens (fixa pra 360dialog, não muda por conta/canal).
WHATSAPP_SEND_URL=https://waba-v2.360dialog.io/messages

# Header de autenticação — API key gerada no painel da 360dialog pro canal do IPESSP.
WHATSAPP_AUTH_HEADER_NAME=D360-API-KEY
WHATSAPP_AUTH_HEADER_VALUE=

# Só usado se algum dia migrarmos pra Meta direta (não é o caminho atual — deixar vazio).
# Nesse caminho alternativo: WHATSAPP_SEND_URL=https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
# WHATSAPP_AUTH_HEADER_NAME=Authorization | WHATSAPP_AUTH_HEADER_VALUE=Bearer <ACCESS_TOKEN>
META_WEBHOOK_VERIFY_TOKEN=

# Telefone da equipe para escalonamento manual (mesmo uso do ZAPI_TELEFONE_EQUIPE original)
WHATSAPP_TELEFONE_EQUIPE=
