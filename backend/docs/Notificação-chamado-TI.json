    {
      "parameters": {
        "jsCode": "const record = $input.first().json.body.record;\nconst status = record.status;\nconst resolucao = record.resolucao;\nconst titulo = record.titulo;\n\nconst mensagens = {\n  em_andamento: `🔧 *Seu chamado está sendo atendido!*\\n\\n*Assunto:* ${titulo}\\n\\nNossa equipe de TI já está trabalhando nisso. Em breve você terá uma resposta.`,\n  aguardando: `⏳ *O TI precisa de mais informações sobre seu chamado.*\\n\\n*Assunto:* ${titulo}\\n\\nEntre em contato com o suporte: wa.me/5511968566862`,\n  resolvido: `✅ *Seu chamado foi resolvido!*\\n\\n*Assunto:* ${titulo}${resolucao ? `\\n\\n*Solução:* ${resolucao}` : ''}\\n\\nSe ainda tiver dúvidas, é só falar aqui.`,\n  fechado: `✅ *Seu chamado foi encerrado.*\\n\\n*Assunto:* ${titulo}${resolucao ? `\\n\\n*Solução:* ${resolucao}` : ''}`,\n};\n\nconst mensagem = mensagens[status];\nif (!mensagem) return [];\n\nreturn [{ json: { telefone: record.telefone_solicitante, mensagem } }];"
      },
