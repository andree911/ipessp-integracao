        "jsCode": "// O detalhamento por funil/origem continua fora da mensagem de WhatsApp (fica\n// grande demais pra texto de notificação) — quem quiser o detalhe abre o dashboard.\nconst r = $input.first().json;\n\nconst mensagem = `📊 Relatório Semanal de Leads — IPESSP\\n\\nTotal geral: ${r.total}\\nNovos este mês: ${r.noMes}\\nEm nurturing ativo: ${r.emNurturing}\\nTaxa de conversão: ${r.taxaConversao}`;\n\nreturn [{ json: { mensagem } }];"
      },
