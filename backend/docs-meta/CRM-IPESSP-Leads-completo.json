      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [272, 400],
      "id": "b1c2d3e4-1111-1111-1111-000000000002",
      "name": "Buscar Prontos para Contato"
    },
    {
      "parameters": {
        "jsCode": "// Mensagens de nutrição são MARKETING (promocionais) para a Meta — precisam de\n// template categoria \"Marketing\" aprovado E de opt-in explícito do lead para WhatsApp\n// (campo `whatsappOptin`, vem direto do GET /v1/leads/prontos-para-contato).\n// Sem opt-in o lead continua avançando de etapa normalmente — só pula o envio do\n// WhatsApp (ver IF \"Tem Opt-in WhatsApp?\" logo abaixo), pra não ficar preso pra sempre\n// na etapa 0 sendo requisitado a cada 30 min.\n// 3 templates, 2 variáveis cada (nome, curso) — ver docs-meta/README.md.\nconst leads = $input.first().json;\nif (!Array.isArray(leads) || leads.length === 0) return [];\n\nconst templatesPorEtapa = [\n  $env.WHATSAPP_TEMPLATE_NURTURING_1,\n  $env.WHATSAPP_TEMPLATE_NURTURING_2,\n  $env.WHATSAPP_TEMPLATE_NURTURING_3,\n];\n\nreturn leads\n  .filter(lead => lead.telefone)\n  .map(lead => {\n    const idx = Math.min(lead.etapaNurturing ?? 0, templatesPorEtapa.length - 1);\n    return {\n      json: {\n        leadId: lead.id,\n        phone: (lead.telefone || '').replace(/\\D/g, ''),\n        enviarWhatsapp: !!lead.whatsappOptin,\n        templateName: templatesPorEtapa[idx],\n        nome: lead.nome,\n        curso: lead.cursoInteresse || 'nossos cursos',\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [528, 400],
      "id": "b1c2d3e4-1111-1111-1111-000000000003",
      "name": "Montar Mensagens Nurturing"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "o1o1o1o1-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.enviarWhatsapp }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [656, 400],
      "id": "o1o1o1o1-0002-4000-8000-000000000002",
      "name": "Tem Opt-in WhatsApp?"
    },
