ADMIN_API_KEY=
BACKEND_URL=https://srv1835634.hstgr.cloud
DATABASE_URL=
# Supabase (origem antiga) exige SSL; o Postgres da VPS não. Coloque "false"
# na VPS -- default (sem a var) preserva o comportamento antigo pra quem
# ainda não migrou.
DATABASE_SSL=false
# Origens autorizadas a chamar a API direto do browser (CORS), separadas por
# vírgula. Sem essa variável o CORS fica desligado.
CORS_ORIGINS=https://www.ipessp.edu.br,https://ipessp.edu.br
# Remetente exclusivo do e-mail de cancelamento (SMTP_FROM continua em cópia/CC).
# Precisa ser um endereço com permissão "Enviar como"/"Enviar em nome de" liberada
# pra SMTP_USER na conta Office 365 — senão o Office 365 rejeita ou marca como spoof.
EMAIL_CANCELAMENTO_FROM=
# CCs do email de cancelamento — pedagógico, trancamento e financeiro, além do
# SMTP_FROM padrão (e do EMAIL_CANCELAMENTO_FROM, que também entra em cópia no reembolso)
EMAIL_CANCELAMENTO_CC_PEDAGOGICO=
EMAIL_CANCELAMENTO_CC_TRANCAMENTO=
EMAIL_CANCELAMENTO_CC_FINANCEIRO=
# CC do comercial nos e-mails de cobrança (tipo cobranca_*, pós-vencimento) —
# não entra em cópia nos e-mails de lembrete, vencimento hoje, aviso ou renegociação.
EMAIL_CC_COMERCIAL=
EMAIL_CRON_HABILITADO=false
EMAIL_SOMENTE_COM_CODIGO=false
EMAIL_DIAS_ANTES=7,5,3,1
EMAIL_DIAS_AVISO=10,9,8,7,6,4,3,2,1
EMAIL_DIAS_APOS=1,2,3,7,8,9,10,12,15,20,25,30
EMAIL_DIAS_RENEGOCIACAO_OVERLAP=1,3,7
EMAIL_ASSETS_BASE_URL=
EMAIL_LOGO_URL=
EMAIL_PORTAL_ALUNO_URL=
ESCOLA_CNPJ=05.699.346/0001-43
ESCOLA_EMAIL_NOTIFICACOES=matricula.financeiro@ipessp.edu.br
ESCOLA_ENDERECO="São Paulo, SP"
ESCOLA_FACEBOOK=https://www.facebook.com/ipesspedu/
ESCOLA_INSTAGRAM=https://www.instagram.com/ipessp/
ESCOLA_LINKEDIN=https://www.linkedin.com/company/ipessp---educa-o/
ESCOLA_NOME=IPESSP
ESCOLA_SITE=https://www.ipessp.edu.br
ESCOLA_TELEFONE="(11) 99839-3640"
ESCOLA_YOUTUBE=https://www.youtube.com/channel/UC7dgP6NBgM9L0m11UbhCyHg
IA_BEARER_TOKEN=
JWT_SECRET=
# ─── Storage (MinIO na VPS, substitui o Supabase Storage) ────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ipessp-admin
MINIO_SECRET_KEY=sua-senha-minio
# Base pública servida pelo Traefik (rota /files/*)
MINIO_PUBLIC_BASE_URL=https://srv1892430.hstgr.cloud/files
NODE_ENV=production
PORT=3000
SMTP_FROM="IPESSP <matricula.financeiro@ipessp.edu.br>"
SMTP_HOST=smtp.office365.com
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=matricula.financeiro@ipessp.edu.br
SOPHIA_BASE_URL=https://portal.sophia.com.br/SophiAWebAPI
SOPHIA_SENHA=
SOPHIA_TENANT=
SOPHIA_USUARIO=
WEBHOOK_SECRET=
# Secret da URL do webhook /whatsapp/webhook/financeiro (2ª instância Z-API,
# ver ZAPI_FINANCEIRO_* acima) -- cadastrada separada no painel da Z-API
# dessa instância, não reaproveita a mesma URL/secret do número de atendimento.
WEBHOOK_SECRET_FINANCEIRO=
WPP_CRON_HABILITADO=false
WPP_DIAS_ANTES=7,5,3,1
WPP_DIAS_APOS=1,2,3,7,8,9,10,12,15,20
# Banners anexados nas mensagens do job de cobrança do WhatsApp (wpp_job),
# além do texto -- URLs públicas no MinIO da VPS (bucket "assets", ver
# scripts/upload-imagem-cobranca.mjs). Lembrete = antes/no dia do vencimento.
# Cobrança = após o vencimento (atraso). Vazio = recurso desligado pra aquele
# tipo, comportamento atual (só texto/lista).
WPP_IMAGEM_LEMBRETE_URL=
WPP_IMAGEM_LEMBRETE_LEGENDA=
WPP_IMAGEM_COBRANCA_URL=
WPP_IMAGEM_COBRANCA_LEGENDA=
ZAPI_CLIENT_TOKEN=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Segunda instância Z-API, número dedicado só pra régua de cobrança
# (whatsapp-job) -- separado do número de atendimento/chatbot acima. Vazio =
# o job de cobrança não envia (mesmo aviso/erro de "Z-API não configurada"
# que já existia, só que agora específico do canal "financeiro").
ZAPI_FINANCEIRO_CLIENT_TOKEN=
ZAPI_FINANCEIRO_INSTANCE_ID=
ZAPI_FINANCEIRO_TOKEN=
ZAPI_TELEFONE_FINANCEIRO=
# Telefone (com DDI/DDD, só números) avisado por WhatsApp quando o chatbot
# encaminha um atendimento de secretaria pra humano (tool "Encaminhar para
# Humano (Secretaria)" em n8n/Bot-IPESSP-WhatsApp.roteado.json).
ZAPI_TELEFONE_SECRETARIA=
# Números (com DDI/DDD) das consultoras de marketing avisadas por WhatsApp a cada lead novo registrado pela IA — separados por vírgula.
# Também recebem o encaminhamento do chatbot quando alguém que ainda não é aluno
# pede atendimento (tool "Encaminhar para Novos Alunos", setor 'comercial').
ZAPI_TELEFONES_CONSULTORAS_MARKETING=

# ============================================================
# Chatbot de WhatsApp (ChatbotService)
# ============================================================
# Chave da API da Anthropic — usada pelo chatbot pra classificar a intenção da
# mensagem e redigir as respostas. Sem ela o chatbot não responde nada (loga o
# erro e a mensagem fica sem resposta).
ANTHROPIC_API_KEY=
# Modelo usado pelo chatbot. Default: claude-sonnet-5 (o mesmo que o fluxo n8n
# usava antes da migração pro backend).
CHATBOT_MODELO=claude-sonnet-5

# ============================================================
# Backend ipessp-core (repositório separado, mesma VPS)
# ============================================================
# Dono do CRM de leads: o chatbot faz POST em {IPESSP_CORE_URL}/crm/leads
# quando fecha a triagem de um interessado. Em produção é o nome do serviço na
# rede interna do Docker Compose. Vazio = o lead ainda é encaminhado pras
# consultoras por WhatsApp, mas não fica gravado no CRM.
IPESSP_CORE_URL=http://ipessp-core:3000
# ADMIN_API_KEY do ipessp-core, enviada como header x-admin-key.
CORE_API_KEY=
