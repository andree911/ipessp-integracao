      "position": [272, 400],
      "id": "b1c2d3e4-1111-1111-1111-000000000002",
      "name": "Buscar Prontos para Contato"
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.first().json;\nif (!Array.isArray(leads) || leads.length === 0) return [];\n\nconst mensagens = [\n  (nome, curso) =>\n    `Olá, ${nome}! 👋\\n\\nFicamos felizes com seu interesse no IPESSP${curso ? ` — especialmente no curso de *${curso}*` : ''}!\\n\\nSou a assistente virtual e estou aqui para tirar suas dúvidas sobre nossos cursos. Pode me perguntar qualquer coisa! 📚\\n\\nSe preferir, nossa equipe também está disponível para um atendimento personalizado.`,\n  (nome) =>\n    `${nome}, vi que você ainda está conhecendo o IPESSP! 🎓\\n\\nPosso te ajudar com:\\n📚 Cursos disponíveis\\n💰 Formas de pagamento\\n📅 Próximas turmas\\n\\nResponda aqui ou fale com nossa equipe!`,\n  (nome) =>\n    `⏰ ${nome}, as vagas estão preenchendo!\\n\\n✅ Processo seletivo simples\\n✅ Parcelamento facilitado\\n✅ Certificado reconhecido\\n\\nGaranta sua vaga: https://ipessp.edu.br/inscricao`,\n];\n\nreturn leads\n  .filter(lead => lead.telefone)\n  .map(lead => ({\n    json: {\n      leadId: lead.id,\n      phone: (lead.telefone || '').replace(/\\D/g, ''),\n      nome: lead.nome,\n      mensagem: (mensagens[lead.etapaNurturing] || mensagens[mensagens.length - 1])(lead.nome, lead.cursoInteresse),\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [528, 400],
      "id": "b1c2d3e4-1111-1111-1111-000000000003",
      "name": "Montar Mensagens Nurturing"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.z-api.io/instances/' + $env.ZAPI_INSTANCE_ID + '/token/' + $env.ZAPI_TOKEN + '/send-text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Client-Token", "value": "={{ $env.ZAPI_CLIENT_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"message\": \"{{ $json.mensagem }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
