# Copie este arquivo para ".env" nesta mesma pasta e preencha os valores reais.
# NUNCA commitar o ".env" real (já está no .gitignore da raiz do repo).

# --- Domínios (precisam estar apontando via DNS pro IP do VPS antes do `docker compose up`) ---
N8N_HOST=n8n.ipessp.edu.br
EVOLUTION_HOST=evolution.ipessp.edu.br

# --- Postgres do n8n ---
N8N_DB_USER=n8n
N8N_DB_PASSWORD=
N8N_DB_NAME=n8n

# --- Postgres da Evolution API ---
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=evolution

# --- n8n ---
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# URL do backend NestJS (continua no Render, não muda)
CORE_API_URL=https://integracao-sophia-n8n.onrender.com
IA_BEARER_TOKEN=

# --- Evolution API ---
# Key global — gere um valor forte e aleatório (ex.: openssl rand -hex 32)
EVOLUTION_API_KEY=
# Nome de cada instância (criadas depois, via API, uma por número/setor)
EVOLUTION_INSTANCE_FINANCEIRO=ipessp-financeiro
EVOLUTION_INSTANCE_SECRETARIA=ipessp-secretaria
EVOLUTION_INSTANCE_TI=ipessp-ti
EVOLUTION_INSTANCE_MARKETING=ipessp-marketing

# --- Notificações internas (mesmo uso de sempre) ---
WHATSAPP_TELEFONE_EQUIPE=
