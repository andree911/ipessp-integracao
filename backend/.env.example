# ============================================================
# Servidor
# ============================================================
PORT=3000

# Origens permitidas no CORS (separe por vírgula).
# Exemplo: https://www.ipessp.edu.br,https://ipessp.edu.br
CORS_ORIGINS=http://localhost:3000

# ============================================================
# SophiA SGx API
# ============================================================

# URL base do servidor SophiA da sua instituição.
# Exemplo: https://sophia.minhaescola.com.br/SophiAWebAPI
SOPHIA_BASE_URL=https://SEU-SERVIDOR/SophiAWebAPI

# Usuário e senha de integração configurados no painel SophiA
# (menu Configurações > API > Integração).
SOPHIA_USUARIO=usuario-integracao
SOPHIA_SENHA=senha-integracao

# Tenant (opcional). Identificador numérico da unidade no SophiA.
# Aparece na URL do sistema (ex: /6150/). Deixe em branco se não usar.
SOPHIA_TENANT=

# ============================================================
# Banco de dados (PostgreSQL — Supabase)
# ============================================================
# Supabase > Settings > Database > Connection string (URI)
# Exemplo: postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres

# ============================================================
# Sincronização de responsáveis financeiros
# ============================================================
# Expressão cron de quando o job roda. Padrão: todo início de hora.
SYNC_CRON=0 * * * *

# Janela retroativa de lançamentos buscados no SophiA (dias).
SYNC_LOOKBACK_DAYS=30

# ============================================================
# Autenticação JWT (portais de aluno e professor)
# ============================================================

# Chave secreta para assinar os JWTs. Use valor aleatório forte.
# Gere com: openssl rand -hex 64
JWT_SECRET=mude-esta-chave-jwt

# URL pública do site (usado no link de redefinição de senha no e-mail).
SITE_URL=https://www.ipessp.edu.br

# ============================================================
# Admin
# ============================================================

# Chave de acesso ao painel administrativo (/v1/admin).
# Enviada como: Authorization: Bearer <valor>
# Gere com: openssl rand -hex 32
ADMIN_API_KEY=mude-esta-chave-admin

# ============================================================
# IA / OpenClaw — endpoints /ia protegidos por Bearer Token
# ============================================================

# Token que o OpenClaw enviará no header Authorization: Bearer <token>.
# Configure o mesmo valor no painel do OpenClaw.
IA_BEARER_TOKEN=mude-este-token-ia

# ============================================================
# Supabase — avisos, calendário e upload de currículos
# ============================================================

# URL do projeto Supabase.
# Onde achar: Supabase > Settings > API > "Project URL"
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Service Role Key (acesso total — use só no servidor).
# Onde achar: Supabase > Settings > API > "service_role" key
SUPABASE_SERVICE_KEY=sua-service-role-key

# ============================================================
# E-mail (SMTP)
# ============================================================
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario@email.com
SMTP_PASS=sua-senha-smtp
SMTP_FROM=noreply@ipessp.edu.br

# ============================================================
# Dados da escola (usados nos e-mails enviados)
# ============================================================
ESCOLA_NOME=Faculdade IPESSP
ESCOLA_TELEFONE=(11) 97692-2127
ESCOLA_SITE=https://www.ipessp.edu.br
ESCOLA_INSTAGRAM=https://instagram.com/ipessp
ESCOLA_FACEBOOK=https://facebook.com/ipessp
ESCOLA_YOUTUBE=
ESCOLA_LINKEDIN=
ESCOLA_CNPJ=00.000.000/0000-00
ESCOLA_ENDERECO=Rua Exemplo, 123 — São Paulo/SP
ESCOLA_EMAIL_NOTIFICACOES=marketing@ipessp.edu.br
EMAIL_LOGO_URL=https://www.ipessp.edu.br/logo.png

# ============================================================
# Job de e-mails de cobrança
# ============================================================

# Habilita o envio automático de e-mails de cobrança (true/false).
EMAIL_CRON_HABILITADO=false

# Dias antes do vencimento para enviar aviso.
EMAIL_DIAS_ANTES=3

# Dias após o vencimento para enviar cobranças (separe por vírgula).
EMAIL_DIAS_APOS=1,3,7

# ============================================================
# n8n — automação de leads
# ============================================================

# URL do webhook do n8n que recebe novos leads.
# Deixe em branco para desabilitar.
N8N_LEADS_WEBHOOK_URL=

# ============================================================
# Webhook (Receiv ou outro sistema externo)
# ============================================================
WEBHOOK_SECRET=mude-este-segredo
