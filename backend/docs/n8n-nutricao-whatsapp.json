{
  "name": "Nutrição WhatsApp — Leads IPESSP",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-criado",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node_webhook",
      "name": "Webhook — Lead Criado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "lead-criado-ipessp"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok"
      },
      "id": "node_respond",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 180]
    },
    {
      "parameters": {
        "url": "https://api.z-api.io/instances/SUA_INSTANCIA/token/SEU_TOKEN/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "client-token", "value": "SEU_CLIENT_TOKEN" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "5511976922127" },
            {
              "name": "message",
              "value": "🔔 *Novo lead no IPESSP!*\n\n👤 *Nome:* {{ $json.nome }}\n📧 *Email:* {{ $json.email ?? '—' }}\n📱 *Telefone:* {{ $json.telefone ?? '—' }}\n📚 *Curso:* {{ $json.cursoInteresse ?? '—' }}\n🌐 *Origem:* {{ $json.origem }}\n\nAcesse o painel: https://ipessp.edu.br/admin/leads"
            }
          ]
        },
        "options": {}
      },
      "id": "node_notif_equipe",
      "name": "WhatsApp — Notificar Equipe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "cond_tel",
              "leftValue": "={{ $json.telefone }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ]
        }
      },
      "id": "node_has_phone",
      "name": "Tem telefone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 360]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "node_wait_5min",
      "name": "Aguarda 5 min (boas-vindas)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [680, 360]
    },
    {
      "parameters": {
        "url": "https://api.z-api.io/instances/{{ $env.ZAPI_INSTANCE }}/token/{{ $env.ZAPI_TOKEN }}/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "client-token", "value": "={{ $env.ZAPI_CLIENT_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $('Webhook — Lead Criado').item.json.telefone.replace(/\\D/g, '') }}" },
            {
              "name": "message",
              "value": "Olá, {{ $('Webhook — Lead Criado').item.json.nome }}! 👋\n\nFicamos felizes com seu interesse no IPESSP!\n\nSou a assistente virtual e estou aqui para tirar suas dúvidas sobre nossos cursos. Pode me perguntar qualquer coisa! 😊\n\nSe preferir, nossa equipe também está disponível para um atendimento personalizado."
            }
          ]
        },
        "options": {}
      },
      "id": "node_msg_boas_vindas",
      "name": "WhatsApp — Boas-vindas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 360]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "days"
      },
      "id": "node_wait_1d",
      "name": "Aguarda 1 dia",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 360]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/v1/admin/leads?status=novo&status=contatado",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.ADMIN_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "node_check_status",
      "name": "Verificar status do lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 360]
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.first().json;\nconst leadId = $('Webhook — Lead Criado').item.json.id;\nconst lead = Array.isArray(leads) ? leads.find(l => l.id === leadId) : null;\nconst statusAtivo = lead && ['novo','contatado'].includes(lead.status);\nreturn [{ json: { continuar: statusAtivo, lead: lead ?? null } }];"
      },
      "id": "node_still_active",
      "name": "Ainda ativo?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 360]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond_ativo",
              "leftValue": "={{ $json.continuar }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
