    {
      "parameters": {
        "jsCode": "const lead = $input.first().json.body;\nconst data = new Date(lead.criadoEm).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst sophia = lead.sophiaCodigo ? '✅ Registrado no SophiA' : '⚠️ Pendente de sync no SophiA';\n\nreturn [{ json: {\n  mensagem:\n    `🎯 *Novo Lead Captado!*\\n\\n` +\n    `👤 Nome: ${lead.nome}\\n` +\n    `📧 E-mail: ${lead.email || 'não informado'}\\n` +\n    `📱 Telefone: ${lead.telefone || 'não informado'}\\n` +\n    `📚 Interesse: ${lead.cursoInteresse || 'não informado'}\\n` +\n    `🌐 Origem: ${lead.origem}\\n` +\n    `⏰ Em: ${data}\\n` +\n    `${sophia}`\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [272, 0],
      "id": "2a3d2cc3-f097-42d3-a660-5ed5b6351b6a",
