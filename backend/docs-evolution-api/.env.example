# --- WhatsApp: Evolution API (self-hosted, Baileys/WhatsApp Web — automação NÃO
# oficial, mesma categoria de risco de bloqueio que o Z-API. Decisão consciente,
# ver docs-evolution-api/README.md) ---

# URL base da sua instância Evolution API self-hosted (ex.: Hostinger VPS).
EVOLUTION_API_URL=https://evolution.seudominio.com.br

# API key global da Evolution API (mesma pros 4 canais — a Evolution API
# normalmente usa uma única key global, diferente da 360dialog que exige
# uma key por canal). Gerada/definida na variável AUTHENTICATION_API_KEY do
# servidor da própria Evolution API.
EVOLUTION_API_KEY=

# Nome de cada instância conectada (uma por número/setor, criada e pareada via
# QR code no painel/API da Evolution API).
EVOLUTION_INSTANCE_FINANCEIRO=ipessp-financeiro
EVOLUTION_INSTANCE_SECRETARIA=ipessp-secretaria
EVOLUTION_INSTANCE_TI=ipessp-ti
EVOLUTION_INSTANCE_MARKETING=ipessp-marketing

# Telefone da equipe (canal Marketing) para escalonamento manual e notificação
# de novo lead/relatórios (mesmo uso do ZAPI_TELEFONE_EQUIPE original).
WHATSAPP_TELEFONE_EQUIPE=
