    {
      "parameters": {
        "url": "={{ $env.CORE_API_URL }}/crm/leads/prontos-para-contato",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-admin-key", "value": "={{ $env.CORE_API_KEY }}" }]
        },
        "options": {}
