    {
      "parameters": {
        "jsCode": "// Template \"notificacao_novo_lead\" (5 variáveis) — ver docs-meta/README.md\nconst lead = $input.first().json.body;\nconst data = new Date(lead.criadoEm).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nreturn [{ json: {\n  nome: lead.nome,\n  email: lead.email || 'não informado',\n  telefone: lead.telefone || 'não informado',\n  cursoInteresse: lead.cursoInteresse || 'não informado',\n  origem: `${lead.origem} — ${data}`,\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [272, 0],
      "id": "0fe9e60d-c7a2-48bf-b2e9-32c7529f943a",
      "name": "Formatar Mensagem Lead"
    },
    {
      "parameters": {
        "method": "POST",
