            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $env.WHATSAPP_TELEFONE_EQUIPE, type: 'template', template: { name: $env.WHATSAPP_TEMPLATE_NOVO_LEAD, language: { code: 'pt_BR' }, components: [{ type: 'body', parameters: [ { type: 'text', text: $json.nome }, { type: 'text', text: $json.email }, { type: 'text', text: $json.telefone }, { type: 'text', text: $json.cursoInteresse }, { type: 'text', text: $json.origem } ] }] } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [528, 0],
      "id": "43c69e3c-3263-4e6b-8ee0-04936306d0b0",
      "name": "Notificar Equipe WhatsApp (Template)"
    },

    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
