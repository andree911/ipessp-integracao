ADMIN_API_KEY=
BACKEND_URL=https://srv1835634.hstgr.cloud
DATABASE_URL=
# Supabase (origem antiga) exige SSL; o Postgres da VPS não. Coloque "false"
# na VPS -- default (sem a var) preserva o comportamento antigo pra quem
# ainda não migrou.
DATABASE_SSL=false
# Origens autorizadas a chamar a API direto do browser (CORS), separadas por
# vírgula. Sem essa variável o CORS fica desligado.
CORS_ORIGINS=https://www.ipessp.edu.br,https://ipessp.edu.br
# Remetente exclusivo do e-mail de cancelamento (SMTP_FROM continua em cópia/CC).
# Precisa ser um endereço com permissão "Enviar como"/"Enviar em nome de" liberada
# pra SMTP_USER na conta Office 365 — senão o Office 365 rejeita ou marca como spoof.
EMAIL_CANCELAMENTO_FROM=
# CCs do email de cancelamento — pedagógico, trancamento e financeiro, além do
# SMTP_FROM padrão (e do EMAIL_CANCELAMENTO_FROM, que também entra em cópia no reembolso)
EMAIL_CANCELAMENTO_CC_PEDAGOGICO=
EMAIL_CANCELAMENTO_CC_TRANCAMENTO=
EMAIL_CANCELAMENTO_CC_FINANCEIRO=
EMAIL_CRON_HABILITADO=false
EMAIL_SOMENTE_COM_CODIGO=false
